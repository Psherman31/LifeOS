# Copy to .env and fill in.

# Where the database file lives.
#   Local development:  file:./dev.db
#   Railway (with a volume mounted at /data):  file:/data/lifeos.db
DATABASE_URL="file:./dev.db"

# Your Anthropic API key, from https://console.anthropic.com
ANTHROPIC_API_KEY=""

# The passcode you will type to open the app. Pick something only you know.
LIFEOS_PASSCODE=""

# Optional: override the Claude model used (defaults to claude-sonnet-5)
# ANTHROPIC_MODEL="claude-sonnet-5"
